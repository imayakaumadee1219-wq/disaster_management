pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Docker Check') {
            steps {
                bat 'docker version'
                bat 'docker compose version'
            }
        }

        stage('Build Images') {
            steps {
                bat 'docker compose build --pull'
            }
        }

        stage('Deploy') {
            steps {
                bat 'docker compose up -d'
            }
        }

        stage('Show Services') {
            steps {
                bat 'docker compose ps'
            }
        }

        stage('Health Check') {
            steps {
                bat 'powershell -NoProfile -Command "$deadline=(Get-Date).AddMinutes(3); do { Start-Sleep -Seconds 10; $ok=$true; foreach($u in @('http://localhost:8761/actuator/health','http://localhost:6001/actuator/health','http://localhost:6002/actuator/health','http://localhost:6003/actuator/health','http://localhost:9100/actuator/health','http://localhost:9095/actuator/health')) { try { $r=Invoke-RestMethod $u -TimeoutSec 5; if($r.status -ne 'UP'){$ok=$false} } catch {$ok=$false} }; if($ok){ exit 0 } } while((Get-Date) -lt $deadline); docker compose ps; exit 1"'
            }
        }
    }

    post {
        failure {
            bat 'docker compose logs --tail=100'
        }
    }
}
